{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "paths": {
            "/script.js": ["src/types/script.d.ts"],
            "/scripts/tags.js": ["src/types/tags.d.ts"],
            "/scripts/utils.js": ["src/types/utils.d.ts"],
            "/scripts/group-chats.js": ["src/types/group-chats.d.ts"],
            "/scripts/world-info.js": ["src/types/world-info.d.ts"]
        },
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": false,
        "esModuleInterop": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["jquery"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "bin"
    ]
}
