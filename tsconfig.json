{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": false,
        "esModuleInterop": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["jquery"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "globals.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "bin"
    ]
}
